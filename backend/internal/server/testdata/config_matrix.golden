== the pair also asks for throughput tests, pinned to the mesh addresses
-- first
{
  "approved_access_tier": 2,
  "cluster_id": "cluster:first",
  "digest": "(present)",
  "heartbeat_seconds": 30,
  "link_peers": [
    {
      "addresses": [
        "10.0.66.1"
      ],
      "cluster_id": "cluster:second",
      "iperf_client": {
        "password": "(present)",
        "public_key_pem": "(present)",
        "username": "(present)"
      },
      "name": "edge",
      "throughput": true,
      "throughput_budget_bytes": "2147483648",
      "throughput_interval_seconds": 3600,
      "via": "mesh"
    }
  ],
  "measure_seconds": 90,
  "probe_targets": [
    {
      "host": "203.0.113.10",
      "id": "pt-1",
      "port": 443
    }
  ],
  "resync_seconds": 900
}
