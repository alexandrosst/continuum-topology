{
  "NativeResponse": {"type": "object", "description": "The backend's own answer, in its own format (for Prometheus and Loki a `status`/`data` envelope; for Tempo the trace or the search result), including its own error shape for a bad query."},
  "Error": {"type": "object", "properties": {"error": {"type": "string", "description": "What went wrong, in words."}}, "required": ["error"]},
  "Status": {"type": "object", "properties": {
    "fusion": {"type": "object", "description": "Whether the stores are up.", "properties": {"available": {"type": "boolean"}, "state": {"type": "string"}}},
    "access": {"type": "object", "description": "What the credential you presented may read.", "properties": {
      "kind": {"type": "string", "enum": ["token", "user"]}, "name": {"type": "string"},
      "signals": {"type": "array", "items": {"type": "string", "enum": ["metrics", "logs", "traces"]}},
      "namespaces": {"type": "array", "items": {"type": "string"}, "description": "Empty means every namespace."},
      "clusters": {"type": "array", "items": {"type": "string"}, "description": "Empty means every cluster."},
      "rawQueries": {"type": "boolean", "description": "Whether PromQL, LogQL and TraceQL as written are allowed (only when nothing is limited)."},
      "expiresAt": {"type": "string", "format": "date-time"}}}}},
  "ApplicationService": {"type": "object", "properties": {"name": {"type": "string"}, "namespace": {"type": "string"}, "cluster": {"type": "string"}, "kind": {"type": "string"},
    "aliases": {"type": "array", "items": {"type": "string"}, "description": "Other names its telemetry may carry as service.name (its app label)."},
    "signals": {"type": "array", "items": {"type": "string"}, "description": "The signals FUSION has for it in the range, matched by service name."}}},
  "Application": {"type": "object", "description": "An Ikhnos application: a group of services.", "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "description": {"type": "string"},
    "services": {"type": "array", "items": {"$ref": "#/components/schemas/ApplicationService"}},
    "signals": {"type": "array", "items": {"type": "string"}, "description": "The signals any of its services has in the range."},
    "namespaces": {"type": "array", "items": {"type": "string"}}, "clusters": {"type": "array", "items": {"type": "string"}}}},
  "ApplicationList": {"type": "object", "properties": {"applications": {"type": "array", "items": {"$ref": "#/components/schemas/Application"}},
    "sources": {"$ref": "#/components/schemas/Sources"}, "from": {"type": "string", "format": "date-time"}, "to": {"type": "string", "format": "date-time"}}},
  "ServiceItem": {"type": "object", "properties": {"name": {"type": "string"}, "signals": {"type": "array", "items": {"type": "string"}},
    "applications": {"type": "array", "items": {"type": "string"}, "description": "The Ikhnos applications this service is in; empty for a service no application has."}}},
  "ServiceList": {"type": "object", "properties": {"services": {"type": "array", "items": {"$ref": "#/components/schemas/ServiceItem"}},
    "sources": {"$ref": "#/components/schemas/Sources"}, "from": {"type": "string", "format": "date-time"}, "to": {"type": "string", "format": "date-time"}}},
  "Overview": {"type": "object", "properties": {"id": {"type": "string", "description": "An application's id (not set for a service)."}, "name": {"type": "string"}, "services": {"type": "array", "items": {"type": "string"}, "description": "For an application: the service names its telemetry may carry."}, "signals": {"type": "array", "items": {"type": "string"}},
    "traces": {"type": "array", "items": {"$ref": "#/components/schemas/TraceSummary"}, "description": "The most recent."},
    "errorTraces": {"type": "array", "items": {"$ref": "#/components/schemas/TraceSummary"}, "description": "The most recent with an error span."},
    "errorLogs": {"type": "array", "items": {"$ref": "#/components/schemas/LogEntry"}},
    "metrics": {"type": "array", "items": {"type": "string"}, "description": "Metric names it reports."},
    "sources": {"$ref": "#/components/schemas/Sources"}, "warnings": {"type": "array", "items": {"type": "string"}}}},
  "Sources": {"type": "object", "additionalProperties": {"type": "string", "enum": ["ok", "not requested", "not allowed", "unavailable", "error"]},
    "description": "What became of each part of a read: ok; not requested; not allowed (the credential does not include that signal); unavailable (the store is off or starting); error."},
  "NameList": {"type": "object", "properties": {"names": {"type": "array", "items": {"type": "string"}}}},
  "SeriesList": {"type": "object", "properties": {"series": {"type": "array", "items": {"type": "object", "additionalProperties": {"type": "string"}}}}},
  "Point": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2, "description": "[unix seconds, value]"},
  "MetricSeries": {"type": "object", "properties": {"name": {"type": "string"}, "labels": {"type": "object", "additionalProperties": {"type": "string"}},
    "points": {"type": "array", "items": {"$ref": "#/components/schemas/Point"}, "description": "Left off when a fused read's point budget ran out; the summary below is always there."},
    "min": {"type": "number"}, "max": {"type": "number"}, "avg": {"type": "number"}, "last": {"type": "number"}}},
  "MetricRange": {"type": "object", "properties": {"series": {"type": "array", "items": {"$ref": "#/components/schemas/MetricSeries"}}, "truncated": {"type": "boolean"},
    "stepSeconds": {"type": "number"}, "from": {"type": "string", "format": "date-time"}, "to": {"type": "string", "format": "date-time"}}},
  "PromResult": {"type": "object", "description": "Prometheus' own answer.", "properties": {"status": {"type": "string"}, "data": {"type": "object"}}},
  "LogEntry": {"type": "object", "properties": {
    "time": {"type": "string", "format": "date-time"}, "line": {"type": "string"}, "severity": {"type": "string"},
    "traceId": {"type": "string"}, "spanId": {"type": "string"},
    "service": {"type": "string"}, "namespace": {"type": "string"}, "pod": {"type": "string"}, "cluster": {"type": "string"},
    "labels": {"type": "object", "additionalProperties": {"type": "string"}, "description": "The stream's index labels."},
    "metadata": {"type": "object", "additionalProperties": {"type": "string"}, "description": "The record's structured metadata."}}},
  "LogResult": {"type": "object", "properties": {"entries": {"type": "array", "items": {"$ref": "#/components/schemas/LogEntry"}}, "truncated": {"type": "boolean"}}},
  "SpanEvent": {"type": "object", "properties": {"time": {"type": "string", "format": "date-time"}, "name": {"type": "string"}, "attributes": {"type": "object"}}},
  "QueryResult": {"type": "object", "description": "One of your promql queries: on a resource for its expansion there, in the fused object's `queries` for a query not about one resource, on a span cut to its time.", "properties": {
    "name": {"type": "string"}, "query": {"type": "string", "description": "The expression as it was evaluated, variables replaced (not repeated on spans)."},
    "series": {"type": "array", "items": {"$ref": "#/components/schemas/MetricSeries"}}, "truncated": {"type": "boolean"},
    "error": {"type": "string", "description": "Why this query has no series; the others are not affected."}}},
  "Neighbour": {"type": "object", "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "kind": {"type": "string", "enum": ["service", "external"]},
    "namespace": {"type": "string"}, "cluster": {"type": "string"}, "protocol": {"type": "string"}, "port": {"type": "integer"}, "confidence": {"type": "string"}, "stale": {"type": "boolean"}}},
  "ResourceTopology": {"type": "object", "description": "Fused with topology: what Ikhnos knows about the service behind a resource, as of now (associated by name, namespace and cluster, not proven).", "properties": {
    "service": {"type": "object", "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "namespace": {"type": "string"}, "cluster": {"type": "string"}, "kind": {"type": "string"},
      "image": {"type": "string"}, "status": {"type": "string"}, "replicas": {"type": "integer"}, "readyReplicas": {"type": "integer"}, "restarts": {"type": "integer"}}},
    "calls": {"type": "array", "items": {"$ref": "#/components/schemas/Neighbour"}, "description": "Services and external addresses it was seen calling."},
    "calledBy": {"type": "array", "items": {"$ref": "#/components/schemas/Neighbour"}, "description": "Services seen calling it."}}},
  "ChangeEvent": {"type": "object", "description": "Something Ikhnos recorded about the estate near the trace.", "properties": {
    "time": {"type": "string", "format": "date-time"}, "kind": {"type": "string", "description": "For example service-scaled, node-status, cluster-added."},
    "targetKind": {"type": "string", "enum": ["cluster", "node", "service", "dependency", "agent"]}, "targetId": {"type": "string"}, "name": {"type": "string"},
    "cluster": {"type": "string"}, "clusterName": {"type": "string"}, "detail": {"type": "string"}, "cause": {"type": "string"}, "severity": {"type": "string"},
    "namespace": {"type": "string"}, "resource": {"type": "string", "description": "The key of the trace resource it is about, when it is about one."}}},
  "Span": {"type": "object", "properties": {
    "spanId": {"type": "string"}, "parentSpanId": {"type": "string"}, "name": {"type": "string"}, "kind": {"type": "string"},
    "service": {"type": "string"}, "namespace": {"type": "string"}, "pod": {"type": "string"}, "node": {"type": "string"}, "cluster": {"type": "string"},
    "resource": {"type": "string", "description": "The key of the entry in `resources` that produced it."},
    "start": {"type": "string", "format": "date-time"}, "end": {"type": "string", "format": "date-time"}, "durationMs": {"type": "number"},
    "status": {"type": "string", "enum": ["unset", "ok", "error"]}, "statusMessage": {"type": "string"}, "depth": {"type": "integer", "description": "0 for a root."},
    "attributes": {"type": "object"}, "events": {"type": "array", "items": {"$ref": "#/components/schemas/SpanEvent"}},
    "logs": {"type": "array", "items": {"$ref": "#/components/schemas/LogEntry"}, "description": "Fused: the lines written under this span's id (exact)."},
    "metrics": {"type": "array", "items": {"$ref": "#/components/schemas/MetricSeries"}, "description": "Fused: the points of the resource's series inside this span's own time, widened by span_pad (associated, not proven)."},
    "queries": {"type": "array", "items": {"$ref": "#/components/schemas/QueryResult"}, "description": "Fused with promql_spans: your per-resource queries cut to this span's time."}}},
  "Resource": {"type": "object", "properties": {
    "key": {"type": "string"}, "service": {"type": "string"}, "namespace": {"type": "string"}, "pod": {"type": "string"}, "node": {"type": "string"}, "cluster": {"type": "string"},
    "attributes": {"type": "object"},
    "metrics": {"type": "array", "items": {"$ref": "#/components/schemas/MetricSeries"}, "description": "Fused: the series over the trace's whole time."}, "metricsTruncated": {"type": "boolean"},
    "logs": {"type": "array", "items": {"$ref": "#/components/schemas/LogEntry"}, "description": "Fused with context_logs: lines this resource wrote around the trace that carry no trace id, oldest first."}, "logsTruncated": {"type": "boolean"},
    "queries": {"type": "array", "items": {"$ref": "#/components/schemas/QueryResult"}, "description": "Fused with promql: your queries that name ${service} and the like, evaluated for this resource over the trace's window."},
    "topology": {"$ref": "#/components/schemas/ResourceTopology"}}},
  "Trace": {"type": "object", "properties": {
    "traceId": {"type": "string"}, "start": {"type": "string", "format": "date-time"}, "end": {"type": "string", "format": "date-time"}, "durationMs": {"type": "number"},
    "services": {"type": "array", "items": {"type": "string"}}, "spanCount": {"type": "integer"}, "errorCount": {"type": "integer"},
    "roots": {"type": "array", "items": {"type": "string"}, "description": "Span ids with no parent in the trace."},
    "spans": {"type": "array", "items": {"$ref": "#/components/schemas/Span"}, "description": "In start order."},
    "resources": {"type": "array", "items": {"$ref": "#/components/schemas/Resource"}},
    "truncated": {"type": "boolean", "description": "The trace was larger than this API returns."}}},
  "FusedTrace": {"allOf": [{"$ref": "#/components/schemas/Trace"}, {"type": "object", "properties": {
    "logs": {"type": "object", "description": "What became of the trace-linked log lines. The lines of a span are on the span.", "properties": {
      "total": {"type": "integer"}, "matched": {"type": "integer", "description": "Lines attached to a span."},
      "unmatched": {"type": "array", "items": {"$ref": "#/components/schemas/LogEntry"}, "description": "Lines that carry the trace id but no span id, or the id of a span the trace does not have."},
      "truncated": {"type": "boolean"}, "onFilteredSpans": {"type": "integer", "description": "Lines on spans a span_* filter left out (included in total and matched)."}}},
    "systemLogs": {"type": "object", "description": "Fused with system_logs.", "properties": {
      "namespaces": {"type": "array", "items": {"type": "string"}}, "nodes": {"type": "array", "items": {"type": "string"}},
      "entries": {"type": "array", "items": {"$ref": "#/components/schemas/LogEntry"}}, "truncated": {"type": "boolean"}}},
    "queries": {"type": "array", "items": {"$ref": "#/components/schemas/QueryResult"}, "description": "Fused with promql: your queries that are not about one resource, over the trace's window."},
    "changes": {"type": "array", "items": {"$ref": "#/components/schemas/ChangeEvent"}, "description": "Fused with include=changes: events about the trace's services, nodes and clusters shortly before and after it, oldest first."},
    "spansOmitted": {"type": "integer", "description": "Spans the span_* filters left out; spanCount is that of the whole trace."},
    "sources": {"$ref": "#/components/schemas/Sources"},
    "joins": {"type": "object", "additionalProperties": {"type": "string"}, "description": "In words, how each requested signal was tied to the trace: logs by the ids they carry (exact), metrics by service, namespace, pod and time (associated, not proven)."},
    "warnings": {"type": "array", "items": {"type": "string"}, "description": "A part that could not be read is named here and in sources; the trace itself always comes back or the whole read fails."}}}]},
  "TraceSummary": {"type": "object", "properties": {"traceId": {"type": "string"}, "rootService": {"type": "string"}, "rootName": {"type": "string"},
    "start": {"type": "string", "format": "date-time"}, "durationMs": {"type": "number"}, "services": {"type": "array", "items": {"type": "string"}}, "matchedSpans": {"type": "integer"}}},
  "BulkItem": {"type": "object", "description": "The outcome for one trace.", "properties": {
    "id": {"type": "string", "description": "As it was asked for."}, "status": {"type": "integer", "description": "200, or what the single read would have answered (400 not a trace id, 404 no such trace, 504 not read in time ...)."},
    "error": {"type": "string"}, "trace": {"$ref": "#/components/schemas/FusedTrace"}}},
  "BulkSummary": {"type": "object", "properties": {"requested": {"type": "integer"}, "ok": {"type": "integer"}, "failed": {"type": "integer"}}},
  "BulkResult": {"type": "object", "description": "As JSON: results in the order of the ids. As NDJSON (`stream=true`): one line `{\"type\":\"result\", ...BulkItem}` per trace in finishing order, then `{\"type\":\"summary\", ...BulkSummary}`.", "properties": {
    "results": {"type": "array", "items": {"$ref": "#/components/schemas/BulkItem"}}, "summary": {"$ref": "#/components/schemas/BulkSummary"}}},
  "TraceList": {"type": "object", "description": "Without fused: just `traces`. With fused=true: `results` holds each hit in full, in the order of `traces`. As NDJSON: a first line `{\"type\":\"traces\", \"traces\":[...]}`, then the result and summary lines of a batch.", "properties": {
    "traces": {"type": "array", "items": {"$ref": "#/components/schemas/TraceSummary"}},
    "results": {"type": "array", "items": {"$ref": "#/components/schemas/BulkItem"}}, "summary": {"$ref": "#/components/schemas/BulkSummary"}}},
  "BatchRequest": {"type": "object", "required": ["ids"], "description": "`ids` and any parameter of the fused read, as JSON: lists as arrays, durations as strings, numbers as numbers.", "properties": {
    "ids": {"type": "array", "maxItems": 25, "items": {"type": "string"}},
    "include": {"type": "array", "items": {"type": "string", "enum": ["logs", "context_logs", "system_logs", "metrics", "topology", "changes", "all", "none"]}},
    "pad": {"type": "string"}, "span_pad": {"type": "string"}, "metric": {"type": "string"}, "metric_scope": {"type": "array", "items": {"type": "string", "enum": ["app", "pod", "node"]}},
    "max_logs": {"type": "integer"}, "max_context_logs": {"type": "integer"}, "max_system_logs": {"type": "integer"}, "max_series": {"type": "integer"}, "points": {"type": "integer"},
    "system_namespaces": {"type": "array", "items": {"type": "string"}}, "log_severity": {"type": "string"}, "log_contains": {"type": "string"},
    "omit": {"type": "array", "items": {"type": "string", "enum": ["attributes", "events"]}},
    "span_service": {"type": "string"}, "span_status": {"type": "string", "enum": ["error", "ok", "unset"]}, "span_min_duration": {"type": "string"},
    "promql": {"description": "Your own queries: an object of name to expression, or a list of `name=expression` strings.", "oneOf": [{"type": "object", "additionalProperties": {"type": "string"}}, {"type": "array", "items": {"type": "string"}}]},
    "promql_spans": {"type": "boolean"}, "promql_step": {"type": "string"}, "promql_pad": {"type": "string"}, "promql_services": {"type": "array", "items": {"type": "string"}},
    "changes_before": {"type": "string"}, "max_changes": {"type": "integer"},
    "stream": {"type": "boolean"}}}
}
