  "uid": "ikhnos-categories",
  "title": "Telemetry by category",
  "version": 1,
  "description": "What FUSION holds, grouped by what it is about: the machines and the telemetry pipeline (system), the cluster's own objects (Kubernetes) and what applications report about themselves (application). The category is decided from the metric's name and from the namespace of a log line or span, the same rule the FUSION API's `category` filter uses, so what is listed here is what that filter returns.",
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "fusion-metrics"
        },
        "query": {
          "query": "label_values(k8s_node_condition_ready, continuum_cluster_id)",
          "refId": "v-cluster"
        },
        "definition": "label_values(k8s_node_condition_ready, continuum_cluster_id)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "System: the machines and the telemetry pipeline",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Nodes reporting host metrics",
      "datasource": {
        "type": "prometheus",
        "uid": "fusion-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (continuum_cluster_id, k8s_node_name) (system_cpu_logical_count{continuum_cluster_id=~\"$cluster\"}))",
          "datasource": {
            "type": "prometheus",
            "uid": "fusion-metrics"
          },
          "instant": true,
          "range": false
        }
      ],
      "description": "Nodes whose host metrics (system_*) reached FUSION.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Scrape targets down",
      "datasource": {
        "type": "prometheus",
        "uid": "fusion-metrics"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(up{continuum_cluster_id=~\"$cluster\"} == 0)",
          "datasource": {
            "type": "prometheus",
            "uid": "fusion-metrics"
          },
          "instant": true,
          "range": false
        }
      ],
      "description": "Targets the collectors scrape (for example an energy exporter) that did not answer the last scrape.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "System metric series",
      "datasource": {
        "type": "prometheus",
        "uid": "fusion-metrics"
