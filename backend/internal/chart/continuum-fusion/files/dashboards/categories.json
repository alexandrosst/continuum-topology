      "targets": [
        {
          "refId": "A",
          "expr": "count({__name__=~\"(system_.*|process_.*|node_.*|kepler_.*|dcgm_.*|otelcol_.*|scrape_.*|up|target_info)\", continuum_cluster_id=~\"$cluster\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "fusion-metrics"
          },
          "instant": true,
          "range": false
        }
      ],
      "description": "Series in the system category (names are placed by the rule in the description of this dashboard).",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
