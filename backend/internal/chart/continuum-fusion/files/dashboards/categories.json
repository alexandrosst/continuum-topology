    {
      "id": 5,
      "type": "timeseries",
      "title": "Host CPU busy",
      "datasource": {
        "type": "prometheus",
        "uid": "fusion-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - sum by (continuum_cluster_id, k8s_node_name) (rate(system_cpu_time_seconds_total{state=\"idle\", continuum_cluster_id=~\"$cluster\"}[$__rate_interval])) / sum by (continuum_cluster_id, k8s_node_name) (rate(system_cpu_time_seconds_total{continuum_cluster_id=~\"$cluster\"}[$__rate_interval])))",
          "datasource": {
            "type": "prometheus",
            "uid": "fusion-metrics"
          },
          "legendFormat": "{{continuum_cluster_id}}/{{k8s_node_name}}"
        }
      ],
      "description": "Share of the host's CPU time that was not idle.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
