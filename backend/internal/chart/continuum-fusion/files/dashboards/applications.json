    {
      "id": 102,
      "type": "row",
      "title": "Application: what its services report",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 103,
      "type": "table",
      "title": "Metrics the services report",
      "datasource": {
        "type": "prometheus",
        "uid": "fusion-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (service_name, __name__) ({__name__=~\".+\", __name__!~\"(system_.*|process_.*|node_.*|kepler_.*|dcgm_.*|otelcol_.*|scrape_.*|up|target_info)|(k8s_.*|container_.*|kube_.*)\", __name__!=\"ikhnos_application_info\", service_name=~\"$service\", k8s_namespace_name=~\"$namespace\", continuum_cluster_id=~\"$cluster\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "fusion-metrics"
          },
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "description": "The metrics of the application category (not Kubernetes or system ones) that these services report, with how many series each has. A service that only logs and traces has none.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "service_name": "Service",
              "__name__": "Metric",
              "Value": "Series"
            }
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Spans per second, by service",
      "datasource": {
        "type": "tempo",
        "uid": "fusion-traces"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "fusion-traces"
          },
          "queryType": "traceql",
          "metricsQueryType": "range",
          "query": "{ resource.service.name =~ \"${service:pipe}\" } | rate() by (resource.service.name)"
        }
      ],
      "description": "Traces of the application's services that reached the store. Needs the trace store's metrics generator, which this chart turns on (tempo.traceqlMetrics). Traces are matched by service name only: a trace can cross clusters, and spans that did not pass an Ikhnos agent carry no cluster id, so the cluster choice does not narrow them.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "noValue": "No traces have arrived yet"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Failing spans per second, by service",
      "datasource": {
        "type": "tempo",
        "uid": "fusion-traces"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "fusion-traces"
          },
          "queryType": "traceql",
          "metricsQueryType": "range",
          "query": "{ resource.service.name =~ \"${service:pipe}\" && status = error } | rate() by (resource.service.name)"
