{
  "uid": "ikhnos-applications",
  "title": "Applications",
  "description": "One Ikhnos application at a glance: the services it is made of, and their pods, traces and logs. Pick the application, then its services: each entry is a service in one namespace of one cluster, so a selection is exact for metrics, pods and logs. Pods are matched by the name of their Deployment, StatefulSet or DaemonSet being the service, in the namespace and cluster of the entry. Traces are matched by service name only (a span says nothing reliable about its cluster, and the trace store cannot filter on a pair of attributes taken from a list), so two entries with the same service name in different namespaces share their traces.",
  "tags": [
    "ikhnos"
  ],
  "schemaVersion": 39,
  "version": 6,
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "application",
        "label": "Application",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "fusion-metrics"
        },
        "query": {
          "query": "label_values(ikhnos_application_info, application)",
          "refId": "v-application"
        },
        "definition": "label_values(ikhnos_application_info, application)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "description": "An application from Ikhnos. Its services are written to Prometheus once a minute while FUSION runs."
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "fusion-metrics"
        },
        "query": {
          "query": "label_values(ikhnos_application_info{application=${application:doublequote}}, k8s_namespace_name)",
          "refId": "v-namespace"
        },
        "definition": "label_values(ikhnos_application_info{application=${application:doublequote}}, k8s_namespace_name)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "description": "Narrows the list of members below to those in these namespaces. A member Ikhnos knows no namespace for is kept by All.",
        "allValue": ".*"
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "fusion-metrics"
        },
        "query": {
          "query": "label_values(ikhnos_application_info{application=${application:doublequote}}, continuum_cluster_id)",
          "refId": "v-cluster"
        },
        "definition": "label_values(ikhnos_application_info{application=${application:doublequote}}, continuum_cluster_id)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "description": "Narrows the list of members below to those in these clusters. A member Ikhnos knows no cluster for is kept by All.",
        "allValue": ".*"
      },
      {
        "name": "member",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "fusion-metrics"
        },
        "query": {
          "query": "label_values(ikhnos_application_info{application=${application:doublequote}, k8s_namespace_name=~\"$namespace\", continuum_cluster_id=~\"$cluster\"}, member)",
          "refId": "v-member"
        },
        "definition": "label_values(ikhnos_application_info{application=${application:doublequote}, k8s_namespace_name=~\"$namespace\", continuum_cluster_id=~\"$cluster\"}, member)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "description": "The services of this application, each as service/namespace/cluster, so a selection is exact: a service in two namespaces is two entries, and choosing one never selects the other. All means exactly the entries listed, not every service there is. An empty part is something Ikhnos does not know."
      },
      {
        "name": "service",
        "label": "Service names (derived)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "fusion-metrics"
        },
        "query": {
          "query": "label_values(ikhnos_application_info{application=${application:doublequote}, member=~\"$member\"}, service_name)",
          "refId": "v-service"
        },
        "definition": "label_values(ikhnos_application_info{application=${application:doublequote}, member=~\"$member\"}, service_name)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "description": "The service names of the selected members; used only to narrow the stores before the exact member filter. Not meant to be changed.",
        "hide": 2
      }
    ]
  },
  "annotations": {
    "list": []
  },
