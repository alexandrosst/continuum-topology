    {
      "id": 103,
      "type": "table",
      "title": "Metrics the services report",
      "datasource": {
        "type": "prometheus",
        "uid": "fusion-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (service_name, __name__) (({__name__=~\".+\", __name__!~\"(system_.*|process_.*|node_.*|kepler_.*|dcgm_.*|otelcol_.*|scrape_.*|up|target_info)|(k8s_.*|container_.*|kube_.*)\", __name__!=\"ikhnos_application_info\", service_name=~\"$service\"}) and on(service_name, k8s_namespace_name, continuum_cluster_id) ikhnos_application_info{application=${application:doublequote}, member=~\"$member\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "fusion-metrics"
          },
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "description": "The metrics of the application category (not Kubernetes or system ones) that these services report, with how many series each has. A service that only logs and traces has none.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "service_name": "Service",
              "__name__": "Metric",
              "Value": "Series"
            }
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Spans per second, by service",
