    },
    {
      "id": 1,
      "type": "stat",
      "title": "Pods not ready",
      "datasource": {
        "type": "prometheus",
        "uid": "fusion-metrics"
      },
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 4,
        "h": 4
