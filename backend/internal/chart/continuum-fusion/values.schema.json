{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "type": "boolean",
      "description": "read by a parent chart's dependency condition (the Ikhnos server chart's fusion.enabled); unused when installed on its own"
    },
    "global": {
      "type": "object"
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "priorityClassName": {
      "type": "string"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "storageClass": {
          "type": "string"
        }
      }
    },
    "prometheus": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[0-9a-f]{64})?$"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "retention": {
          "type": "string",
          "pattern": "^[0-9]+(y|w|d|h|m|s|ms)$"
        },
        "storage": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|K|M|G|T)?$"
        },
        "resources": {
          "type": "object"
        },
        "promoteResourceAttributes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "webPrefix": {
          "type": "string",
          "pattern": "^(/[A-Za-z0-9._~-]+)*/?$"
        },
        "retentionSize": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[0-9]+(B|KB|MB|GB|TB|PB))?$"
            },
            {
              "const": 0
            }
          ]
        }
      }
    },
    "loki": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[0-9a-f]{64})?$"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "retention": {
          "type": "string",
          "pattern": "^[0-9]+h$"
        },
        "storage": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|K|M|G|T)?$"
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "tempo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[0-9a-f]{64})?$"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "retention": {
          "type": "string",
          "pattern": "^[0-9]+h$"
        },
        "storage": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|K|M|G|T)?$"
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allowedIngress": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "switch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "managed": {
          "type": "boolean"
        },
        "initialReplicas": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "central": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[0-9a-f]{64})?$"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "receiver": {
          "description": "Retired. The gateway's TLS Secret is always <name>-central-receiver-tls, because the Ikhnos server fills it in by that name. Only the empty string an earlier release stored is still accepted, so a --reuse-values upgrade does not fail; anything else is refused instead of silently ignored.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tlsSecretName": {
              "enum": [
                ""
              ]
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "annotations": {
              "type": "object"
            },
            "loadBalancerSourceRanges": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "queue": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": {
              "type": "integer",
              "minimum": 1
            },
            "retryMaxElapsedTime": {
              "type": "string",
              "pattern": "^[0-9]+(ms|s|m|h)$"
            },
            "persistent": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "sizeLimit": {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|k|M|G|T)?$"
                }
              }
            }
          }
        },
        "batch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "timeout": {
              "type": "string",
              "pattern": "^[0-9]+(ms|s|m)$"
            },
            "sendBatchSize": {
              "type": "integer",
              "minimum": 1
            },
            "sendBatchMaxSize": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "deltaToCumulative": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxStale": {
              "type": "string",
              "pattern": "^[0-9]+(ms|s|m|h)$"
            },
            "maxStreams": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "grafana": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[0-9a-f]{64})?$"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "storage": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|K|M|G|T)?$"
        },
        "resources": {
          "type": "object"
        },
        "role": {
          "enum": [
            "Viewer",
            "Editor",
            "Admin"
          ]
        },
        "allowedIngress": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  }
}
