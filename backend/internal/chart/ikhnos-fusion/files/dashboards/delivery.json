{
  "uid": "ikhnos-delivery",
  "title": "Delivery health",
  "description": "Is the data arriving: how fresh each cluster is, through which operator, which signals are flowing, and whether the collectors themselves are healthy.",
  "tags": [
    "ikhnos",
    "delivery"
  ],
  "schemaVersion": 39,
  "version": 5,
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "fusion-metrics"
        },
        "query": {
          "query": "query_result(max by (ikhnos_cluster_id, cluster_name) (label_replace(topk by (cluster) (1, ikhnos_cluster_info), \"ikhnos_cluster_id\", \"$1\", \"cluster\", \"(.+)\")))",
          "refId": "v-cluster"
        },
        "definition": "query_result(max by (ikhnos_cluster_id, cluster_name) (label_replace(topk by (cluster) (1, ikhnos_cluster_info), \"ikhnos_cluster_id\", \"$1\", \"cluster\", \"(.+)\")))",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "regex": "/cluster_name=\"(?<text>[^\"]*)\",\\s*ikhnos_cluster_id=\"(?<value>[^\"]+)\"/",
        "description": "The clusters, by name. All includes a cluster whose name the server does not know (shown by its id)."
      },
      {
        "name": "operator",
        "label": "Operator",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "fusion-metrics"
        },
        "query": {
          "query": "label_values(ikhnos_operator_id)",
          "refId": "v-operator"
        },
        "definition": "label_values(ikhnos_operator_id)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "description": "The regional operators the data came through. Narrows the table of data age and the series arriving by operator."
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Agents joined or left",
        "enable": true,
        "iconColor": "blue",
        "datasource": {
          "type": "prometheus",
          "uid": "fusion-metrics"
        },
        "expr": "changes(ikhnos_self_connected_agents[2m]) > 0",
        "step": "1m",
        "titleFormat": "Agents connected changed",
        "textFormat": "The server's connected agents changed; see Ikhnos self."
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "title": "Ikhnos",
      "tags": [
        "ikhnos"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "icon": "dashboard"
    },
    {
      "type": "link",
      "title": "Fleet overview",
      "url": "/d/ikhnos-fleet",
      "tooltip": "All clusters side by side",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false,
      "asDropdown": false,
      "tags": []
    },
    {
      "type": "link",
      "title": "Ikhnos self",
      "url": "/d/ikhnos-self",
      "tooltip": "The server and the agents themselves",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false,
      "asDropdown": false,
      "tags": []
    },
    {
      "type": "link",
      "title": "Clusters and nodes",
      "url": "/d/ikhnos-clusters",
      "tooltip": "The nodes of the chosen clusters",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false,
      "asDropdown": false,
      "tags": []
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Slowest cluster, seconds since data",
      "datasource": {
        "type": "prometheus",
        "uid": "fusion-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(time() - (max by (ikhnos_cluster_id) (timestamp({ikhnos_cluster_id=~\"$cluster\", ikhnos_cluster_id!=\"\", __name__!~\"ikhnos_application_info|ikhnos_agent_self_.*\"})) or max by (ikhnos_cluster_id) (max_over_time(timestamp({ikhnos_cluster_id=~\"$cluster\", ikhnos_cluster_id!=\"\", __name__!~\"ikhnos_application_info|ikhnos_agent_self_.*\"})[1d:5m]))))",
          "datasource": {
            "type": "prometheus",
            "uid": "fusion-metrics"
          },
          "instant": true,
          "range": false
        }
      ],
      "description": "How long ago the quietest cluster last sent anything: a metric of any kind from the cluster, whatever the signal. Looks back one day; a cluster that moved to another operator counts once, by its newest data. Green under 3 minutes, amber under 15, red beyond. Empty when no cluster has reported in the last day.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 180
              },
              {
                "color": "red",
                "value": 900
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Clusters reporting",
      "datasource": {
        "type": "prometheus",
        "uid": "fusion-metrics"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (ikhnos_cluster_id) ({ikhnos_cluster_id=~\"$cluster\", ikhnos_cluster_id!=\"\", __name__!~\"ikhnos_application_info|ikhnos_agent_self_.*\"})) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "fusion-metrics"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "description": "Clusters that sent a metric in the last 5 minutes, of any kind."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Scrape targets down",
      "datasource": {
        "type": "prometheus",
        "uid": "fusion-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(up{ikhnos_cluster_id=~\"$cluster\"} == 0) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "fusion-metrics"
          },
          "instant": true,
          "range": false
        }
      ],
      "description": "Exporters the collectors scrape (for example Kepler or DCGM) that did not answer.",
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "all up",
                  "color": "green",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Collector restarts, last hour",
      "datasource": {
        "type": "prometheus",
        "uid": "fusion-metrics"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "round(sum(increase(k8s_container_restarts{ikhnos_cluster_id=~\"$cluster\", k8s_pod_name=~\"ikhnos-telemetry.*|.*regional-operator.*\"}[1h])))",
          "datasource": {
            "type": "prometheus",
            "uid": "fusion-metrics"
          },
          "instant": true,
          "range": false
        }
      ],
      "description": "Restarts of the telemetry collectors and regional operators themselves. They restart when they run out of memory. Needs the pod metrics (telemetry.kubernetesState or resourceUsage): \"No data\" means they are not being collected, not that nothing restarted.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "none",
                  "color": "green",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Time since last data, by cluster and operator",
      "datasource": {
        "type": "prometheus",
        "uid": "fusion-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((time() - (max by (ikhnos_cluster_id, ikhnos_operator_id) (timestamp({ikhnos_operator_id=~\"$operator\", ikhnos_cluster_id=~\"$cluster\", ikhnos_cluster_id!=\"\", __name__!~\"ikhnos_application_info|ikhnos_agent_self_.*\"})) or max by (ikhnos_cluster_id, ikhnos_operator_id) (max_over_time(timestamp({ikhnos_operator_id=~\"$operator\", ikhnos_cluster_id=~\"$cluster\", ikhnos_cluster_id!=\"\", __name__!~\"ikhnos_application_info|ikhnos_agent_self_.*\"})[1d:5m])))) * on (ikhnos_cluster_id) group_left (cluster_name) label_replace(topk by (cluster) (1, ikhnos_cluster_info), \"ikhnos_cluster_id\", \"$1\", \"cluster\", \"(.+)\") or ignoring (cluster_name) label_replace((time() - (max by (ikhnos_cluster_id, ikhnos_operator_id) (timestamp({ikhnos_operator_id=~\"$operator\", ikhnos_cluster_id=~\"$cluster\", ikhnos_cluster_id!=\"\", __name__!~\"ikhnos_application_info|ikhnos_agent_self_.*\"})) or max by (ikhnos_cluster_id, ikhnos_operator_id) (max_over_time(timestamp({ikhnos_operator_id=~\"$operator\", ikhnos_cluster_id=~\"$cluster\", ikhnos_cluster_id!=\"\", __name__!~\"ikhnos_application_info|ikhnos_agent_self_.*\"})[1d:5m])))), \"cluster_name\", \"$1\", \"ikhnos_cluster_id\", \"(.+)\")) * on (ikhnos_cluster_id) group_left (cluster_name) label_replace(topk by (cluster) (1, ikhnos_cluster_info), \"ikhnos_cluster_id\", \"$1\", \"cluster\", \"(.+)\") or ignoring (cluster_name) label_replace(((time() - (max by (ikhnos_cluster_id, ikhnos_operator_id) (timestamp({ikhnos_operator_id=~\"$operator\", ikhnos_cluster_id=~\"$cluster\", ikhnos_cluster_id!=\"\", __name__!~\"ikhnos_application_info|ikhnos_agent_self_.*\"})) or max by (ikhnos_cluster_id, ikhnos_operator_id) (max_over_time(timestamp({ikhnos_operator_id=~\"$operator\", ikhnos_cluster_id=~\"$cluster\", ikhnos_cluster_id!=\"\", __name__!~\"ikhnos_application_info|ikhnos_agent_self_.*\"})[1d:5m])))) * on (ikhnos_cluster_id) group_left (cluster_name) label_replace(topk by (cluster) (1, ikhnos_cluster_info), \"ikhnos_cluster_id\", \"$1\", \"cluster\", \"(.+)\") or ignoring (cluster_name) label_replace((time() - (max by (ikhnos_cluster_id, ikhnos_operator_id) (timestamp({ikhnos_operator_id=~\"$operator\", ikhnos_cluster_id=~\"$cluster\", ikhnos_cluster_id!=\"\", __name__!~\"ikhnos_application_info|ikhnos_agent_self_.*\"})) or max by (ikhnos_cluster_id, ikhnos_operator_id) (max_over_time(timestamp({ikhnos_operator_id=~\"$operator\", ikhnos_cluster_id=~\"$cluster\", ikhnos_cluster_id!=\"\", __name__!~\"ikhnos_application_info|ikhnos_agent_self_.*\"})[1d:5m])))), \"cluster_name\", \"$1\", \"ikhnos_cluster_id\", \"(.+)\")), \"cluster_name\", \"$1\", \"ikhnos_cluster_id\", \"(.+)\")",
          "datasource": {
            "type": "prometheus",
            "uid": "fusion-metrics"
          },
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "description": "Which operator each cluster's data arrived through, and how fresh it is, newest first. A cluster that stopped sending keeps its row, growing older; one that moved to another operator keeps a row for the old operator until a day has passed.",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Seconds since data"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 180
                    },
                    {
                      "color": "red",
                      "value": 900
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "ikhnos_cluster_id": true
            },
            "renameByName": {
              "ikhnos_operator_id": "Operator",
              "Value": "Seconds since data",
              "cluster_name": "Cluster"
            },
            "indexByName": {
              "cluster_name": 0
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Seconds since data"
              }
            ]
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Series arriving, by cluster",
      "datasource": {
        "type": "prometheus",
        "uid": "fusion-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(count by (ikhnos_cluster_id) ({ikhnos_cluster_id=~\".+\", ikhnos_cluster_id=~\"$cluster\", __name__!~\"ikhnos_application_info|ikhnos_agent_self_.*\"})) * on (ikhnos_cluster_id) group_left (cluster_name) label_replace(topk by (cluster) (1, ikhnos_cluster_info), \"ikhnos_cluster_id\", \"$1\", \"cluster\", \"(.+)\") or ignoring (cluster_name) label_replace((count by (ikhnos_cluster_id) ({ikhnos_cluster_id=~\".+\", ikhnos_cluster_id=~\"$cluster\", __name__!~\"ikhnos_application_info|ikhnos_agent_self_.*\"})), \"cluster_name\", \"$1\", \"ikhnos_cluster_id\", \"(.+)\")",
          "datasource": {
            "type": "prometheus",
            "uid": "fusion-metrics"
          },
          "legendFormat": "{{cluster_name}}",
          "interval": "5m"
        }
      ],
      "description": "How many different metric series each cluster is sending. A drop is a signal that went quiet.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "mean",
            "max"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Series arriving, by operator",
      "datasource": {
        "type": "prometheus",
        "uid": "fusion-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (ikhnos_operator_id) ({ikhnos_operator_id=~\".+\", ikhnos_operator_id=~\"$operator\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "fusion-metrics"
          },
          "legendFormat": "{{ikhnos_operator_id}}",
          "interval": "5m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "mean",
            "max"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "How many series each regional operator is delivering. A line that drops to zero is an operator that stopped sending."
    },
    {
      "id": 8,
      "type": "table",
      "title": "Scrape targets",
      "datasource": {
        "type": "prometheus",
        "uid": "fusion-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((up{ikhnos_cluster_id=~\"$cluster\"}) * on (ikhnos_cluster_id) group_left (cluster_name) label_replace(topk by (cluster) (1, ikhnos_cluster_info), \"ikhnos_cluster_id\", \"$1\", \"cluster\", \"(.+)\") or ignoring (cluster_name) label_replace((up{ikhnos_cluster_id=~\"$cluster\"}), \"cluster_name\", \"$1\", \"ikhnos_cluster_id\", \"(.+)\")) * on (ikhnos_cluster_id) group_left (cluster_name) label_replace(topk by (cluster) (1, ikhnos_cluster_info), \"ikhnos_cluster_id\", \"$1\", \"cluster\", \"(.+)\") or ignoring (cluster_name) label_replace(((up{ikhnos_cluster_id=~\"$cluster\"}) * on (ikhnos_cluster_id) group_left (cluster_name) label_replace(topk by (cluster) (1, ikhnos_cluster_info), \"ikhnos_cluster_id\", \"$1\", \"cluster\", \"(.+)\") or ignoring (cluster_name) label_replace((up{ikhnos_cluster_id=~\"$cluster\"}), \"cluster_name\", \"$1\", \"ikhnos_cluster_id\", \"(.+)\")), \"cluster_name\", \"$1\", \"ikhnos_cluster_id\", \"(.+)\")",
          "datasource": {
            "type": "prometheus",
            "uid": "fusion-metrics"
          },
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "description": "Exporters the collectors scrape. 1 is up, 0 is down.",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Up"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "down",
                        "color": "red"
                      },
                      "1": {
                        "text": "up",
                        "color": "green"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "ikhnos_operator_id": true,
              "ikhnos_org_id": true,
              "node": true,
              "service_name": true,
              "ikhnos_cluster_id": true
            },
            "renameByName": {
              "job": "Target",
              "instance": "Address",
              "k8s_node_name": "Node",
              "Value": "Up",
              "cluster_name": "Cluster"
            },
            "indexByName": {
              "cluster_name": 0
            }
          }
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Collector memory and CPU",
      "datasource": {
        "type": "prometheus",
        "uid": "fusion-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (ikhnos_cluster_id, k8s_pod_name) (k8s_pod_memory_working_set_bytes{ikhnos_cluster_id=~\"$cluster\", k8s_pod_name=~\"ikhnos-telemetry.*|.*regional-operator.*\"})) * on (ikhnos_cluster_id) group_left (cluster_name) label_replace(topk by (cluster) (1, ikhnos_cluster_info), \"ikhnos_cluster_id\", \"$1\", \"cluster\", \"(.+)\") or ignoring (cluster_name) label_replace((sum by (ikhnos_cluster_id, k8s_pod_name) (k8s_pod_memory_working_set_bytes{ikhnos_cluster_id=~\"$cluster\", k8s_pod_name=~\"ikhnos-telemetry.*|.*regional-operator.*\"})), \"cluster_name\", \"$1\", \"ikhnos_cluster_id\", \"(.+)\")",
          "datasource": {
            "type": "prometheus",
            "uid": "fusion-metrics"
          },
          "legendFormat": "{{cluster_name}}/{{k8s_pod_name}} memory"
        }
      ],
      "description": "Working-set memory of the collector and operator pods.",
