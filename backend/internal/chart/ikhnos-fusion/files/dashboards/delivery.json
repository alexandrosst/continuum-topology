        "y": 26,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * sum by (k8s_namespace_name) (rate({k8s_namespace_name=~\".+\"} | ikhnos_cluster_id=~\"$cluster\" [$__interval]))",
          "datasource": {
            "type": "loki",
            "uid": "fusion-logs"
          },
          "legendFormat": "{{k8s_namespace_name}}"
        }
      ],
      "description": "Logs that reached the store, by namespace. Flat zero for a namespace you expect logs from means they are not getting through.",
