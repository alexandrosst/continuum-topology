    {
      "id": 12,
      "type": "timeseries",
      "title": "Spans per second, by service",
      "datasource": {
        "type": "tempo",
        "uid": "fusion-traces"
      },
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "fusion-traces"
          },
          "queryType": "traceql",
          "metricsQueryType": "range",
          "query": "{} | rate() by (resource.service.name)"
        }
      ],
      "description": "Traces that reached the store. Needs the trace store's metrics generator, which this chart turns on (tempo.traceqlMetrics). Not narrowed by cluster: a trace can cross clusters, and spans that did not pass an Ikhnos agent carry no cluster id.",
      "fieldConfig": {
        "defaults": {
          "noValue": "No traces have arrived yet",
