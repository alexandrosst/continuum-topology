{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "continuum-agent values",
  "description": "Unknown keys are rejected on purpose: a misspelt setting such as access.teir would otherwise be ignored silently, and the tier would fall back to the widest default.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "address": {
          "type": "string"
        },
        "caPin": {
          "type": "string"
        }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tier": {
          "type": [
            "integer",
            "string"
          ],
          "enum": [
            0,
            1,
            2,
            "0",
            "1",
            "2"
          ],
          "description": "0 registered only, 1 infrastructure, 2 services"
        }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "cluster",
            "namespaced"
          ],
          "description": "cluster: one ClusterRole, cluster-wide read access (default). namespaced: a Role per namespace in scope.namespaces instead, for tier 2."
        }
      }
    },
    "enrollment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token": {
          "type": [
            "string",
            "integer"
          ]
        },
        "key": {
          "type": "string",
          "pattern": "^$|^[0-9a-f]{64}\\.[A-Za-z0-9_-]+$",
          "description": "server.caPin and enrollment.token, joined as '<caPin>.<token>'; what the install command prints instead of the two flags separately."
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "selector": {
          "type": "string"
        }
      }
    },
    "mesh": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "readPolicy": {
          "type": "boolean"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": [
            "string",
            "number"
          ]
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[0-9a-f]{64})?$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "tuning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "goMemLimit": {
          "type": "string"
        },
        "goGC": {
          "type": [
            "string",
            "integer"
          ]
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "priorityClassName": {
      "type": "string"
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "httpProxy": {
          "type": "string"
        },
        "httpsProxy": {
          "type": "string"
        },
        "noProxy": {
          "type": "string"
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "apiServerCIDRs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "apiServerPorts": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            },
            "serverCIDRs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "dnsCIDRs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "extraEgress": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "nodeProbe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hostSys": {
          "type": "boolean"
        },
        "interval": {
          "type": "string"
        },
        "secret": {
          "type": [
            "string",
            "integer"
          ]
        },
        "networkPolicy": {
          "type": "boolean"
        },
        "resources": {
          "type": "object"
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "image": {
          "type": "object",
          "description": "Removed: the probe runs the top-level image (with the argument `probe`). Accepted and ignored so an older install command does not fail."
        }
      }
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "flowObserver": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "method": {
          "enum": [
            "auto",
            "ebpf",
            "conntrack"
          ]
        },
        "interval": {
          "type": "string"
        },
        "liveBytes": {
          "type": "boolean"
        },
        "secret": {
          "type": [
            "string",
            "integer"
          ]
        },
        "networkPolicy": {
          "type": "boolean"
        },
        "nodeCIDRs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resources": {
          "type": "object"
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "image": {
          "type": "object",
          "description": "Removed: the collector runs the top-level image (with the argument `flow`). Accepted and ignored so an older install command does not fail."
        }
      }
    }
  }
}
