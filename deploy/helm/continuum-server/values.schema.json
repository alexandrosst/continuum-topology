{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "continuum-server values",
  "type": "object",
  "required": [
    "agent"
  ],
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "image": {
      "type": "object",
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": [
            "string",
            "number"
          ]
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "",
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "registration": {
      "type": "string",
      "enum": [
        "invite",
        "open",
        "closed"
      ]
    },
    "org": {
      "type": "string",
      "minLength": 1
    },
    "agent": {
      "type": "object",
      "required": [
        "publicAddress"
      ],
      "properties": {
        "publicAddress": {
          "type": "string",
          "description": "host:port agents dial (required). Empty and malformed values are rejected by the chart with an explanation."
        },
        "extraHosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "LoadBalancer",
                "NodePort",
                "ClusterIP"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "nodePort": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 30000,
              "maximum": 32767
            },
            "annotations": {
              "type": "object"
            },
            "loadBalancerIP": {
              "type": "string"
            },
            "loadBalancerClass": {
              "type": "string"
            },
            "loadBalancerSourceRanges": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "externalTrafficPolicy": {
              "type": "string",
              "enum": [
                "",
                "Cluster",
                "Local"
              ]
            },
            "labels": {
              "type": "object"
            }
          }
        },
        "tlsRoute": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "apiVersion": {
              "type": "string"
            },
            "parentRefs": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "hostnames": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "annotations": {
              "type": "object"
            }
          }
        },
        "behindProxy": {
          "type": "boolean",
          "description": "a hop in front of the agent Service (your own reverse proxy's TCP/SNI passthrough, typically) sends a PROXY protocol header ahead of each connection; the server then requires and trusts it for the connecting address instead of the raw TCP peer. Leave false for plain LoadBalancer, NodePort or agent.tlsRoute."
        }
      }
    },
    "admin": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "behindTlsProxy": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "tls": {
          "type": "object",
          "properties": {
            "secretName": {
              "type": "string"
            },
            "certKey": {
              "type": "string"
            },
            "keyKey": {
              "type": "string"
            },
            "selfSigned": {
              "type": "boolean"
            },
            "selfSignedHosts": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "annotations": {
              "type": "object"
            },
            "labels": {
              "type": "object"
            }
          }
        },
        "existingPasswordSecret": {
          "type": "string"
        },
        "existingPasswordSecretKey": {
          "type": "string",
          "minLength": 1
        },
        "sso": {
          "type": "object",
          "properties": {
            "headerName": {
              "type": "string",
              "description": "name of a request header a trusted reverse proxy sets to a signed-in person's username; empty disables trusted-header SSO entirely. Requires admin.behindTlsProxy=true (or httproute.enabled)."
            }
          }
        }
      }
    },
    "httproute": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "parentRefs": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "existingClaim": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "ReadWriteOnce",
              "ReadWriteOncePod",
              "ReadWriteMany",
              "ReadOnlyMany"
            ]
          }
        },
        "size": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi|Ei|k|M|G|T|P|E)?$"
        },
        "annotations": {
          "type": "object"
        },
        "keepOnUninstall": {
          "type": "boolean"
        }
      }
    },
    "pki": {
      "type": "object",
      "properties": {
        "encryptAtRest": {
          "type": "boolean"
        },
        "caKeyPassphraseSecret": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          }
        }
      }
    },
    "neo4j": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "bundled",
            "external"
          ]
        },
        "allowInsecureHttp": {
          "type": "boolean"
        },
        "user": {
          "type": "string",
          "minLength": 1
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "auth": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "passwordKey": {
              "type": "string"
            }
          }
        },
        "external": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            },
            "passwordKey": {
              "type": "string",
              "minLength": 1
            },
            "usernameKey": {
              "type": "string"
            }
          }
        },
        "image": {
          "type": "object",
          "required": [
            "repository",
            "tag"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64})?$"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "persistence": {
          "type": "object",
          "properties": {
            "storageClass": {
              "type": "string"
            },
            "accessModes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "size": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi|Ei|k|M|G|T|P|E)?$"
            },
            "annotations": {
              "type": "object"
            }
          }
        },
        "memory": {
          "type": "object",
          "properties": {
            "heapInitial": {
              "type": "string",
              "pattern": "^[0-9]+[kKmMgG]$"
            },
            "heapMax": {
              "type": "string",
              "pattern": "^[0-9]+[kKmMgG]$"
            },
            "pagecache": {
              "type": "string",
              "pattern": "^[0-9]+[kKmMgG]$"
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "networkPolicy": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "podSecurityContext": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        },
        "probes": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "priorityClassName": {
          "type": "string"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "extraEnv": {
          "type": "array"
        }
      }
    },
    "agentInstall": {
      "type": "object",
      "properties": {
        "imageRegistry": {
          "type": "string"
        },
        "imageTag": {
          "type": "string"
        },
        "chartRef": {
          "type": "string"
        }
      }
    },
    "geoip": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "publicIpService": {
          "type": "string",
          "description": "An http(s) URL that answers with this server's own public IP as plain text, used only to estimate the location of an agent whose own connecting address cannot be located at all (private, loopback, CGNAT) - the common case when the server and its agents share a network. Empty (default): never guessed, the privacy-conserving default. Recommended value: https://api.ipify.org."
        },
        "asnPath": {
          "type": "string",
          "description": "A second, optional .mmdb in ASN shape (GeoLite2-ASN, DB-IP ASN Lite), not city/country shape. Adds which network an address belongs to (AS number and organisation) alongside wherever the city/country database placed it. Entirely offline. Empty (default): a bundled free DB-IP ASN Lite database is already used; set this only to use a different one."
        }
      }
    },
    "decider": {
      "type": "object",
      "properties": {
        "allowCIDRs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "priorityClassName": {
      "type": "string"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "automountServiceAccountToken": {
      "type": "boolean"
    },
    "resources": {
      "type": "object"
    },
    "tuning": {
      "type": "object",
      "properties": {
        "goMemLimit": {
          "type": "string"
        }
      }
    },
    "probes": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "extraArgs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraVolumes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraVolumeMounts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraInitContainers": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraObjects": {
      "type": "array"
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": [
            "integer",
            "string"
          ]
        },
        "maxUnavailable": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingress": {
          "type": "object",
          "properties": {
            "agent": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            },
            "admin": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "egress": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "dnsTo": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "neo4jCIDRs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "deciderCIDRs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "deciderPorts": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            },
            "geoipPublicIpCIDRs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "geoipPublicIpPorts": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            },
            "extra": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "backup": {
      "type": "object",
      "properties": {
        "volumeSnapshot": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "schedule": {
              "type": "string",
              "minLength": 1
            },
            "timeZone": {
              "type": "string"
            },
            "className": {
              "type": "string"
            },
            "retain": {
              "type": "integer",
              "minimum": 1
            },
            "readyTimeout": {
              "type": "string",
              "pattern": "^[0-9]+[smh]$"
            },
            "includeNeo4j": {
              "type": "boolean"
            },
            "image": {
              "type": "object",
              "required": [
                "repository",
                "tag"
              ],
              "properties": {
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "tag": {
                  "type": "string",
                  "minLength": 1
                },
                "pullPolicy": {
                  "type": "string",
                  "enum": [
                    "Always",
                    "IfNotPresent",
                    "Never"
                  ]
                }
              }
            },
            "resources": {
              "type": "object"
            },
            "successfulJobsHistoryLimit": {
              "type": "integer",
              "minimum": 0
            },
            "failedJobsHistoryLimit": {
              "type": "integer",
              "minimum": 0
            },
            "suspend": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "allowLoosePermissions": {
      "type": "boolean",
      "description": "start the server with --allow-loose-permissions (fsGroup volumes are group-accessible)"
    }
  }
}
